  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:related": "jest --passWithNoTests --findRelatedTests",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "playwright test",
