    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "db:preparar-teste": "node --env-file-if-exists=.env scripts/preparar-banco-teste.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-form": "^1.33.5",
