# Copie para .env e preencha. Nunca versione o .env.
# Senhas das contas de demo: gere o hash com `npm run senha:hash`.

# Banco (npm run dev e scripts, host localhost). O compose monta o DATABASE_URL do app com host db.
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
POSTGRES_USER=<usuario-do-banco>
POSTGRES_PASSWORD=<senha-do-banco>
POSTGRES_DB=<nome-do-banco>

# Origem aceita nas escritas; https liga o cookie Secure.
APP_URL=http://localhost:3000

# Conta de analista
DEMO_ANALISTA_USUARIO=<usuario-do-analista>
DEMO_ANALISTA_NOME=<nome-do-analista>
DEMO_ANALISTA_SENHA_HASH=<gere com: npm run senha:hash>

# Conta de administrador
DEMO_ADMIN_USUARIO=<usuario-do-administrador>
DEMO_ADMIN_NOME=<nome-do-administrador>
DEMO_ADMIN_SENHA_HASH=<gere com: npm run senha:hash>

# Sessão e bloqueio de login (padrões)
SESSAO_INATIVIDADE_MIN=120
LOGIN_MAX_FALHAS=5
LOGIN_JANELA_MIN=15
LOGIN_BLOQUEIO_MIN=15

# debug só local
LOG_NIVEL=info
